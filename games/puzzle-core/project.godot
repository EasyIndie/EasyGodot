; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Puzzle Core"
config/description="Game Factory 的第一个试点游戏：3D 几何滚动解谜。验证自动化游戏制作工作流。"
config/version="0.1.0"
; 应用图标（1024×1024）。这一个文件同时是：
;   · 桌面窗口图标
;   · Android 启动器图标（导出时自动生成各密度）
;   · iOS 启动器图标（导出时自动生成各尺寸）
; 由 tools/make_store_assets.gd 生成，改配色后重跑即可（不要手工 P 图，会与游戏配色脱节）。
config/icon="res://icon.png"
; 启动画面换成本项目自己的标记（透明底 + 与网页背景同色）。
; 默认是 Godot 的 logo —— 既不是我们的品牌，也和游戏配色完全不搭。
boot_splash/bg_color=Color(0.043137, 0.058824, 0.094118, 1)
boot_splash/image="res://web/splash.png"
boot_splash/show_image=true
; 说明：Godot 4.7 没有 fullsize 这个字段（真实字段是 stretch_mode，默认 0 = 按自身尺寸居中），
; 写错的名字不会报错、也不会生效，只会让人以为设过了 —— 所以这里不留它。
boot_splash/use_filter=true
; Android 返回键 / iOS 边缘返回手势交给我们自己处理（见 main.gd::_notification）。
; 默认是 true = 按返回键直接退出游戏，玩家会以为「闪退」。
config/quit_on_go_back=false
run/main_scene="res://scenes/main.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
; 拉伸模式显式设为 disabled —— 这是**有意为之**，不要“顺手修好”：
;
;   * 视口尺寸 = 窗口尺寸(CSS px)，3D 渲染目标 = 窗口尺寸 × devicePixelRatio，
;     于是 Retina / 高 DPI 屏上 3D 是原生分辨率渲染（清晰），而不是把固定分辨率
;     的画面放大（发虚）。
;   * UI 用 CSS px 布局，和系统字体、触摸目标尺寸同一套单位：
;     一个 132px 的按钮在手机和 4K 显示器上**物理大小一致**，
;     这正是“不同设备保持相同显示质量”的含义。
;   * 若改成 canvas_items 拉伸，UI 会按虚拟分辨率缩放，触摸目标在手机上会偏小、
;     在 4K 上会偏大，反而破坏一致性。像素比由 Web 端的 DPR 预算控制
;     （workflow/web/head_include.html），原生平台由系统 DPI 缩放处理。
window/stretch/mode="disabled"

; 屏幕方向：6 = SENSOR（横竖屏都允许）。
; 本作的 UI 是分辨率无关的，横竖屏都做过适配（触屏控件会重排），所以不锁方向；
; 玩家躺着/坐着都能玩，也不用维护两套布局。
window/handheld/orientation=6

[gui]

; 默认字体：Noto Sans SC（开源 OFL，含中文字形），避免中文显示为豆腐块
theme/custom_font="res://fonts/NotoSansSC-Regular.otf"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

; ── 画质与 GPU 预算 ─────────────────────────────────────────────────
;
; 1) MSAA 3D：这里是 4x。抗锯齿对“看起来精细”贡献极大（斜边不再有阶梯），
;    而 gl_compatibility 下的多重采样帧缓冲代价可控。
;    运行时会由 meta/render_quality.gd 按实测帧时间自适应降级
;    （4x → 2x → 关），所以弱设备不会因此卡死。
anti_aliasing/quality/msaa_3d=2
; 2D 不做多重采样：HUD 只有圆角面板和文字，文字本身是距离场渲染，不缺这一项。
anti_aliasing/quality/msaa_2d=0
;
; 2) 方向光阴影贴图：默认 4096×4096 = 1680 万像素，比整个画面（Web 端约 300-400 万）
;    还大好几倍。这正是之前 Safari “WebGL context lost” 的元凶（GPU 内存被吃穿、
;    上下文被回收）。降到 1024（约 100 万像素），阴影依然干净。
lights_and_shadows/directional_shadow/size=1024
lights_and_shadows/directional_shadow/size.mobile=1024
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
;
; 3) 本作没有位置光源，但把图集尺寸一并压低，避免默认值被意外分配
lights_and_shadows/positional_shadow/atlas_size=1024
;
; 4) ETC2/ASTC 纹理压缩：**Android 导出硬要求**（Godot 会直接报
;    "ETC2/ASTC texture compression is required for Android export" 并拒绝出包）。
;    Android 设备的 GPU 需要 ETC2/ASTC 格式的纹理，Godot 必须把它一起打进 pck。
;    代价：每张纹理会多一份压缩版本。本作几乎没有贴图（只有图标），所以代价可忽略；
;    将来若加了大量贴图，要重新评估包体。
textures/vram_compression/import_etc2_astc=true

; 5) 纹理：本作是纯色材质 + 程序化渐变，没有需要 mipmap 的贴图；
;    保持默认（线性过滤）即可，不额外开关。
