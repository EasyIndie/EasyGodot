; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Puzzle Core"
config/description="Game Factory 的第一个试点游戏：3D 几何滚动解谜。验证自动化游戏制作工作流。"
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[gui]

; 默认字体：Noto Sans SC（开源 OFL，含中文字形），避免中文显示为豆腐块
theme/custom_font="res://fonts/NotoSansSC-Regular.otf"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

; ── Web / 移动端 GPU 预算很紧（Safari 尤其）——以下是实测踩坑后的显式限定 ──
;
; 1) 关掉 MSAA：多重采样帧缓冲在受限 GPU 上代价很高
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/msaa_2d=0
;
; 2) 方向光阴影默认 4096×4096 = 1680 万像素，比整个画面（我们钐制在 160 万）还大 10 倍！
;    这是 GPU 内存被吃穿、上下文被 Safari 回收的直接原因之一。降到 1024（约 100 万像素）。
lights_and_shadows/directional_shadow/size=1024
lights_and_shadows/directional_shadow/size.mobile=512
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
;
; 3) 本作没有位置光源，但把图集尺寸一并压低，避免默认值被意外分配
lights_and_shadows/positional_shadow/atlas_size=1024
