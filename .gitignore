# Godot
.godot/
games/*/build/

# 工作流本地依赖（大文件，不入库）
workflow/godot-bin/

# 关卡生成输出（可再生）
games/*/levels/generated/

# 分发包（gf-package.sh 产物，可再生）
dist/

# 截图工具 / 本地调试输出
games/*/_*.png
games/*/_*.png.import
.tools/

# ── 移动端 ────────────────────────────────────────────
# 签名文件绝不入库（丢了无法更新已上架的应用，但泄露更致命）
*.keystore
*.jks
*.p12
*.mobileprovision
# Godot 的 Android 构建模板 + Gradle 缓存/产物。
# **实测 1.3GB**（含 .gradle 缓存），且一条命令就能重建，绝不能入库。
games/*/android/
android/build/
# 生成的移动端产物
games/*/build/android/
games/*/build/ios/
